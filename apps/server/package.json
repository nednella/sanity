{
  "name": "@sanity/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target=bun --packages=external --sourcemap=linked --outdir dist",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:bootstrap": "bun run db:migrate && bun run catalogue:bosses && bun run db:port && bun run catalogue:uniques && bun run catalogue:items && bun run db:heal",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:heal": "bun scripts/heal/index.ts",
    "db:port": "bun scripts/port/index.ts",
    "wom:sync": "bun scripts/wom-group-sync.ts",
    "wom:names": "bun scripts/wom-name-sync.ts",
    "catalogue:bosses": "bun scripts/catalogue/seed-bosses.ts",
    "catalogue:items": "bun scripts/catalogue/seed-items.ts",
    "catalogue:uniques": "bun scripts/catalogue/seed-uniques.ts",
    "key:create": "bun scripts/keys/create.ts",
    "key:list": "bun scripts/keys/list.ts",
    "key:revoke": "bun scripts/keys/revoke.ts",
    "openapi": "bun scripts/openapi.ts",
    "rank:check": "bun scripts/bulk-rank-check.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.8.1",
    "@sanity/urls": "workspace:*",
    "@sanity/utils": "workspace:*",
    "@scalar/fastify-api-reference": "^1.73.0",
    "@wise-old-man/utils": "^4.0.24",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "fastify-type-provider-zod": "^7.0.0",
    "postgres": "^3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.10",
    "mysql2": "^3.24.4",
    "pino-pretty": "^13.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
