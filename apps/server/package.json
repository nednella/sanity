{
  "name": "@sanity/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:bootstrap": "pnpm db:migrate && pnpm catalogue:bosses && pnpm db:port && pnpm catalogue:uniques && pnpm catalogue:items && pnpm db:heal",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:heal": "tsx --env-file-if-exists=.env scripts/heal/index.ts",
    "db:port": "tsx --env-file-if-exists=.env scripts/port/index.ts",
    "wom:sync": "tsx --env-file-if-exists=.env scripts/wom-group-sync.ts",
    "wom:names": "tsx --env-file-if-exists=.env scripts/wom-name-sync.ts",
    "catalogue:bosses": "tsx --env-file-if-exists=.env scripts/catalogue/seed-bosses.ts",
    "catalogue:items": "tsx --env-file-if-exists=.env scripts/catalogue/seed-items.ts",
    "catalogue:uniques": "tsx --env-file-if-exists=.env scripts/catalogue/seed-uniques.ts",
    "openapi": "tsx --env-file-if-exists=.env scripts/openapi.ts",
    "rank:check": "tsx --env-file-if-exists=.env scripts/bulk-rank-check.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@sanity/urls": "workspace:*",
    "@scalar/fastify-api-reference": "^1.73.0",
    "@wise-old-man/utils": "^4.0.24",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "fastify-type-provider-zod": "^7.0.0",
    "postgres": "^3.4.9",
    "tsx": "^4.23.13",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "drizzle-kit": "^0.31.10",
    "mysql2": "^3.24.4",
    "pino-pretty": "^13.1.3",
    "typescript": "~6.0.3"
  }
}
