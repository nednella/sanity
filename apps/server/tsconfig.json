{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],

    /* Bundler mode */
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "paths": {
      "@/*": ["./src/*"],
      "@db/*": ["./db/*"],
      "@config": ["./config.ts"]
    }
  },
  "include": ["src", "db", "scripts", "config.ts", "drizzle.config.ts"]
}
