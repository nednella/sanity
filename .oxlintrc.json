{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "oxc", "promise", "typescript", "unicorn"],
  "jsPlugins": ["@sanity/lint", "@stylistic/eslint-plugin", "eslint-plugin-perfectionist"],
  "categories": {
    "correctness": "error",
    "pedantic": "error",
    "perf": "error",
    "restriction": "error",
    "style": "error",
    "suspicious": "error"
  },
  "env": {
    "builtin": true,
    "es2026": true,
    "node": true
  },
  "settings": {
    "better-tailwindcss": {
      "cwd": "apps/web",
      "entryPoint": "src/main.css"
    }
  },
  "ignorePatterns": ["**/*.js", "**/dist", "apps/web/src/routeTree.gen.ts", "packages/api/src/v1.d.ts"],
  "rules": {
    "@stylistic/max-len": [
      "error",
      {
        "code": 120,
        "comments": 80,
        "ignoreRegExpLiterals": true,
        "ignoreStrings": true,
        "ignoreTemplateLiterals": true,
        "ignoreUrls": true
      }
    ],
    "@stylistic/spaced-comment": ["error", "always"],
    "capitalized-comments": ["error", "always", { "ignoreConsecutiveComments": true }],
    "complexity": "off",
    "curly": ["error", "multi-line"],
    "default-case": "off",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "func-style": ["error", "declaration"],
    "id-length": "off",
    "import/consistent-type-specifier-style": "off",
    "import/exports-last": "off",
    "import/group-exports": "off",
    "import/max-dependencies": "off",
    "import/no-cycle": "off",
    "import/no-duplicates": [
      "error",
      {
        "preferInline": true
      }
    ],
    "import/no-named-export": "off",
    "import/no-namespace": "off",
    "import/no-nodejs-modules": "off",
    "import/no-unassigned-import": "off",
    "import/prefer-default-export": "off",
    "import/unambiguous": "off",
    "max-lines": "off",
    "max-lines-per-function": "off",
    "max-params": "off",
    "max-statements": "off",
    "new-cap": ["error", { "capIsNewExceptions": ["Fastify"] }],
    "no-await-in-loop": "off",
    "no-continue": "off",
    "no-eq-null": "off",
    "no-magic-numbers": "off",
    "no-plusplus": ["error", { "allowForLoopAfterthoughts": true }],
    "no-redeclare": "off",
    "no-shadow": ["error", { "allow": ["_"] }],
    "no-ternary": "off",
    "no-undefined": "off",
    "no-underscore-dangle": ["error", { "allow": ["_zod"] }],
    "no-unused-expressions": [
      "error",
      {
        "allowShortCircuit": false,
        "allowTaggedTemplates": false,
        "allowTernary": false
      }
    ],
    "no-use-before-define": "off",
    "no-useless-assignment": "error",
    "one-var": "off",
    "oxc/no-async-await": "off",
    "oxc/no-map-spread": "off",
    "oxc/no-optional-chaining": "off",
    "oxc/no-rest-spread-properties": "off",
    "perfectionist/sort-object-types": [
      "error",
      {
        "partitionByComment": true,
        "type": "natural"
      }
    ],
    "perfectionist/sort-union-types": [
      "error",
      {
        "groups": ["unknown", "nullish"],
        "type": "natural"
      }
    ],
    "prefer-const": [
      "error",
      {
        "destructuring": "any",
        "ignoreReadBeforeAssign": false
      }
    ],
    "promise/prefer-await-to-callbacks": "off",
    "require-await": "off",
    "sanity/exports-first": "error",
    "sanity/object-function-types": "error",
    "sanity/type-above-first-use": "error",
    "sort-imports": [
      "error",
      {
        "ignoreDeclarationSort": true
      }
    ],
    "sort-keys": "off",
    "typescript/consistent-type-definitions": "off",
    "typescript/explicit-function-return-type": "off",
    "typescript/explicit-member-accessibility": ["error", { "accessibility": "no-public" }],
    "typescript/explicit-module-boundary-types": "off",
    "typescript/no-inferrable-types": "off",
    "typescript/no-non-null-assertion": "off",
    "typescript/prefer-function-type": "off",
    "unicorn/no-null": "off",
    "unicorn/no-useless-iterator-to-array": "error",
    "unicorn/no-useless-undefined": ["error", { "checkArguments": false }],
    "unicorn/number-literal-case": "off"
  },
  "overrides": [
    // allow default exports for config files and packages
    {
      "files": ["**/*.config.ts", "packages/lint/**/index.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    // node
    {
      "files": ["apps/bot/**/*.ts", "apps/server/**/*.ts"],
      "plugins": ["node"],
      "rules": {
        "node/no-process-env": "off",
        "node/no-top-level-await": "off"
      }
    },
    // scripts report to the terminal
    {
      "files": ["apps/server/scripts/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    // react
    {
      "env": {
        "browser": true
      },
      "files": ["apps/web/**/*.{ts,tsx}"],
      "jsPlugins": ["eslint-plugin-better-tailwindcss"],
      "plugins": ["react"],
      "rules": {
        "better-tailwindcss/enforce-canonical-classes": "error",
        "better-tailwindcss/enforce-consistent-important-position": "error",
        "better-tailwindcss/enforce-consistent-line-wrapping": [
          "error",
          {
            "printWidth": 120,
            "strictness": "loose"
          }
        ],
        "better-tailwindcss/enforce-consistent-variable-syntax": "error",
        "better-tailwindcss/enforce-consistent-variant-order": "error",
        "better-tailwindcss/no-concatenated-classes": "error",
        "better-tailwindcss/no-conflicting-classes": "error",
        "better-tailwindcss/no-deprecated-classes": "error",
        "better-tailwindcss/no-duplicate-classes": "error",
        "better-tailwindcss/no-unknown-classes": "error",
        "better-tailwindcss/no-unnecessary-whitespace": "error",
        "perfectionist/sort-jsx-props": [
          "error",
          {
            "type": "natural"
          }
        ],
        "react/exhaustive-deps": "warn",
        "react/forbid-component-props": "off",
        "react/incompatible-library": "warn",
        "react/jsx-curly-brace-presence": [
          "error",
          {
            "children": "never",
            "props": "never"
          }
        ],
        "react/jsx-filename-extension": ["error", { "extensions": [".tsx"] }],
        "react/jsx-handler-names": "off",
        "react/jsx-max-depth": ["error", { "max": 5 }],
        "react/jsx-no-constructed-context-values": "off",
        "react/jsx-no-literals": "off",
        "react/jsx-props-no-spreading": "off",
        "react/no-clone-element": "off",
        "react/no-multi-comp": "off",
        "react/no-object-type-as-default-prop": "off",
        "react/only-export-components": [
          "error",
          {
            "allowConstantExport": true
          }
        ],
        "react/react-in-jsx-scope": "off",
        "react/unsupported-syntax": "warn"
      }
    },
    // tanstack router
    {
      "files": ["apps/web/src/routes/**/*.tsx"],
      "plugins": ["react"],
      "rules": {
        "react/only-export-components": "off",
        "sanity/route-component-name": "error"
      }
    }
  ]
}
